table FCT_PLAYER_SEASON
	lineageTag: 56d7d7a1-c742-4db2-825c-3fe21b94e149

	measure 'Score medio' = AVERAGE(FCT_PLAYER_SEASON[GOALS])
		lineageTag: 12a3a150-7133-4582-8ac4-1fec7715947b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor de mercado por temporada' = SUM(FCT_PLAYER_SEASON[AVERAGE_MARKET_VALUE])
		lineageTag: dbbd6203-714b-4c9b-b1ec-fdb1c8564cb4

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Valor total de mercado' = ```
			
			
			VAR LatestSeason =
			    CALCULATE(
			        MAX(DIM_SEASON[SEASON]),
			        ALL(DIM_SEASON)
			    )
			
			RETURN CALCULATE(
			    SUM(FCT_PLAYER_SEASON[AVERAGE_MARKET_VALUE]),
			    DIM_SEASON[SEASON] =
			        COALESCE(
			            SELECTEDVALUE(DIM_SEASON[SEASON]),
			            LatestSeason
			        )
			)
			
			```
		lineageTag: 2f8c1f8b-f7f8-475f-973d-31c7f7691281

		annotation PBI_FormatHint = {"isGeneralNumber":true}

